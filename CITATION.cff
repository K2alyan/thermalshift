type: software
title: "ThermalShift: Telemetry-aware workload placement using persistent server thermal fingerprints"
version: 0.1.0
date-released: "2026-09-28"
license: MIT
repository-code: "https://github.com/K2alyan/thermalshift"
doi: "10.5281/zenodo.23020901"
authors:
  - family-names: Kottapalli
    given-names: Kalyan
